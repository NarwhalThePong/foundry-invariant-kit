pragma solidity ^0.8.20;

// EXPERIMENTAL fuzz handler for SimpleLendingPool (lending). Actions were inferred from function names; check them.
// Generated by foundry-invariant-kit. This is a starting point for your own
// invariant testing, not a guarantee of correctness or security. Review every
// property, add protocol-specific ones, and tune the bounds below.

import {Test} from "forge-std/Test.sol";
import {SimpleLendingPool} from "../../../src/SimpleLendingPool.sol";
import {SimpleLendingPoolAsset} from "./SimpleLendingPoolAsset.sol";

contract SimpleLendingPoolHandler is Test {
    SimpleLendingPool public immutable pool;
    SimpleLendingPoolAsset public immutable asset;
    address[] internal actors;
    address internal currentActor;
    uint256 internal constant MAX_AMOUNT = 1e30;
    mapping(bytes32 => uint256) public calls;

    // Ghost flags, set when a rule is broken during a successful call.
    bool public ghost_unhealthyAfterBorrow;   // a borrow succeeded but left the borrower over the LTV / health threshold
    bool public ghost_unhealthyAfterWithdraw; // a collateral withdrawal succeeded but left the account unhealthy
    bool public ghost_repayIncreasedDebt;     // repay increased the payer's debt
    bool public ghost_repayOverCredited;      // repay reduced debt by more than the assets the pool received
    bool public ghost_liquidatedHealthy;      // liquidate succeeded against a healthy position

    modifier useActor(uint256 seed) {
        currentActor = actors[bound(seed, 0, actors.length - 1)];
        vm.startPrank(currentActor);
        _;
        vm.stopPrank();
    }

    constructor(SimpleLendingPool _pool, SimpleLendingPoolAsset _asset, address[] memory _actors) {
        pool = _pool;
        asset = _asset;
        actors = _actors;
    }

    // ---------------------------------------------------------------------------------------------
    // ACCOUNT-HEALTH HOOK (EXPERIMENTAL). Source: detected `deposits(address)` / `debts(address)`; healthy means debt * 10000 <= collateral * LTV (bps), values taken 1:1 (no oracle).
    // Override or edit these for your protocol (oracle prices, multiple assets, interest accrual).
    // ---------------------------------------------------------------------------------------------
    uint256 public constant BPS = 10_000;
    uint256 public constant LTV_BPS = 7500; // TODO: set to your max loan-to-value (bps), or pass --ltv-bps
    uint256 public constant HEALTH_FACTOR_ONE = 1e18; // TODO: your protocol's health-factor scale

    function collateralValue(address user) public view virtual returns (uint256) {
        return pool.deposits(user);
    }

    function debtValue(address user) public view virtual returns (uint256) {
        return pool.debts(user);
    }

    function isHealthy(address user) public view virtual returns (bool) {
        return debtValue(user) * BPS <= collateralValue(user) * LTV_BPS;
    }

    function deposit(uint256 actorSeed, uint256 amount) external useActor(actorSeed) {
        amount = bound(amount, 0, MAX_AMOUNT);
        asset.mint(currentActor, amount);
        asset.approve(address(pool), amount);
        pool.deposit(amount);
        calls["deposit"]++;
    }

    function withdraw(uint256 actorSeed, uint256 amount) external useActor(actorSeed) {
        amount = bound(amount, 0, MAX_AMOUNT);
        pool.withdraw(amount);
        if (!isHealthy(currentActor)) ghost_unhealthyAfterWithdraw = true;
        calls["withdraw"]++;
    }

    function borrow(uint256 actorSeed, uint256 amount) external useActor(actorSeed) {
        amount = bound(amount, 0, MAX_AMOUNT);
        pool.borrow(amount);
        if (!isHealthy(currentActor)) ghost_unhealthyAfterBorrow = true;
        calls["borrow"]++;
    }

    function repay(uint256 actorSeed, uint256 amount) external useActor(actorSeed) {
        amount = bound(amount, 0, debtValue(currentActor));
        asset.mint(currentActor, amount);
        asset.approve(address(pool), amount);
        uint256 debtBefore = debtValue(currentActor);
        uint256 cashBefore = asset.balanceOf(address(pool));
        pool.repay(amount);
        uint256 debtAfter = debtValue(currentActor);
        uint256 paid = asset.balanceOf(address(pool)) - cashBefore;
        if (debtAfter > debtBefore) ghost_repayIncreasedDebt = true;
        if (debtBefore > debtAfter && debtBefore - debtAfter > paid) ghost_repayOverCredited = true;
        calls["repay"]++;
    }
}
